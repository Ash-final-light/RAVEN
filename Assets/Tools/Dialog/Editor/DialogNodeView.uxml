<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Tools/Dialog/Editor/DialogNodeViewStyle.uss?fileID=7433441132597879392&amp;guid=f864302dc9584ddc891fbb64b63f1e16&amp;type=3#DialogNodeViewStyle" />
    <ui:VisualElement name="node-state" style="flex-grow: 1; background-color: rgb(37, 37, 37);" />
    <ui:VisualElement name="node-border" style="background-color: rgb(56, 56, 56);">
        <ui:VisualElement name="contents">
            <ui:VisualElement name="top">
                <ui:VisualElement name="input" />
                <ui:VisualElement name="divider" class="horizontal" />
                <ui:VisualElement name="title">
                    <ui:Label name="LbnodeType" text="nodeType" class="unity-text-element unity-label" style="font-size: 20px; color: rgb(255, 255, 255);" />
                    <ui:VisualElement name="title-button-container">
                        <ui:VisualElement name="collapse-button">
                            <ui:VisualElement name="icon" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label tabindex="-1" text="speaker" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Lbspeaker" style="white-space: normal; max-width: 250px; color: rgb(255, 255, 255);" />
                <ui:Label tabindex="-1" text="content" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Lbcontent" style="white-space: normal; max-width: 150px; color: rgb(255, 255, 255);" />
                <ui:VisualElement name="divider" class="vertical" />
                <ui:VisualElement name="output" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="selection-border" picking-mode="Ignore" />
</ui:UXML>
