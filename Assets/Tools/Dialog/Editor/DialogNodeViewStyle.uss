#node-border {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    background-color: rgb(47, 47, 47);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

#input {
    align-items: center;
}

#output {
    align-items: center;
}

#selection-border {
    border-left-color: rgb(0, 236, 255);
    border-right-color: rgb(0, 236, 255);
    border-top-color: rgb(0, 236, 255);
    border-bottom-color: rgb(0, 236, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

:hover > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:selected > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:hover:selected > #selection-border {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.node {
    min-width: 150px;
    -unity-font-style: bold;
}

#title {
}

#description {
    font-size: 10px;
}

#divider {
    background-color: rgb(112, 112, 112);
    min-height: 1px;
}

.option #input {
    background-color: rgb(246, 255, 0);
}

.simple #input {
    background-color: rgb(0, 214, 255);
}

.root #input {
    background-color: rgb(255, 0, 0);
    min-height: 20px;
}

#node-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    background-color: rgb(0, 0, 0);
    bottom: 0;
}

.running #node-state {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 233, 0);
}

.success #node-state {
    background-color: rgb(16, 255, 0);
}

.unstarted #node-state {
    background-color: rgb(255, 0, 0);
}
